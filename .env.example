# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values.
# The backend reads the RTP_SERVER_* values, the client reads the RTP_CLIENT_*
# values.  Both can live in the same .env file.
# ---------------------------------------------------------------------------

# ===== Backend (server) =====================================================
RTP_SERVER_HOST=0.0.0.0
RTP_SERVER_PORT=8000

# Default ReceiptLine editor / API width in characters per line (24-96).
# RTP_SERVER_RECEIPTLINE_CPL=42

# --- Static tokens (machine-to-machine auth) --------------------------------
# Legacy shared secret used for BOTH the printer and the HTTP API when the
# specific tokens below are unset. Leave everything empty to disable token auth
# (fine for a trusted LAN).
RTP_SERVER_TOKEN=
# Secret the WebSocket printer clients must present (overrides RTP_SERVER_TOKEN
# for the printer). Must match RTP_CLIENT_TOKEN on the Raspberry Pi.
# RTP_SERVER_PRINTER_TOKEN=
# Static bearer token for scripts / CI hitting the HTTP API (overrides
# RTP_SERVER_TOKEN for the API). Used by examples/send_receipt.py --token.
# RTP_SERVER_API_TOKEN=

# --- OIDC login for web-UI users (Gitea) ------------------------------------
# Humans log in through Gitea. Create an OAuth2 application in Gitea
# (Settings -> Applications) with redirect URI <public-url>/auth/callback and
# enable the "groups" claim if you want to restrict by org/team.
RTP_SERVER_OIDC_ENABLED=false
RTP_SERVER_OIDC_ISSUER=https://git.example.com
RTP_SERVER_OIDC_CLIENT_ID=
RTP_SERVER_OIDC_CLIENT_SECRET=
# RTP_SERVER_OIDC_SCOPES=openid profile email groups
# Public base URL of THIS backend; used to build the OIDC redirect URI.
# RTP_SERVER_PUBLIC_URL=https://printer.example.com
# Allow-lists (comma separated). When both are empty, any authenticated Gitea
# user may log in. Otherwise the user must match at least one entry.
# RTP_SERVER_OIDC_ALLOWED_USERS=alice,bob@example.com
# RTP_SERVER_OIDC_ALLOWED_GROUPS=myorg,myorg:printer-admins
# Secret used to sign the login session cookie (set a long random value in prod).
# RTP_SERVER_SESSION_SECRET=
# RTP_SERVER_SESSION_TTL_HOURS=12

# --- Over-the-air client updates --------------------------------------------
# When true (default), a connecting client running older code is sent the
# client bundle this server ships; the device applies it and reloads itself.
# RTP_SERVER_AUTO_UPDATE=true


# ===== Client (Raspberry Pi) ================================================
# WebSocket URL of the backend. Use wss:// when terminating TLS in front of it.
RTP_CLIENT_SERVER_URL=ws://localhost:8000/ws
# Printer token: must match RTP_SERVER_PRINTER_TOKEN (or RTP_SERVER_TOKEN).
RTP_CLIENT_TOKEN=
RTP_CLIENT_PRINTER_ID=pi-printer-1
RTP_CLIENT_PRINTER_NAME=Front desk Epson

# Automatically apply code updates pushed by the server and reload into them
# (the client re-execs itself; no manual restart). Set false to opt out.
# RTP_CLIENT_AUTO_UPDATE=true

# Printer connection: usb | network | serial | file | cups | dummy
RTP_CLIENT_CONNECTION=dummy

# Width of the printer head in dots (80mm -> 576, 58mm -> 384).
# Images and PDF pages wider than this are scaled down to fit.
RTP_CLIENT_PRINTER_WIDTH=576

# Optional python-escpos profile name (enables image centering, etc.)
# RTP_CLIENT_PRINTER_PROFILE=TM-T88III

# --- usb ---
# Find the IDs with `lsusb` (e.g. Epson is 04b8). Hex strings are accepted.
RTP_CLIENT_USB_VENDOR_ID=0x04b8
RTP_CLIENT_USB_PRODUCT_ID=0x0202
# RTP_CLIENT_USB_IN_EP=0x82
# RTP_CLIENT_USB_OUT_EP=0x01

# --- network ---
RTP_CLIENT_NET_HOST=192.168.1.50
RTP_CLIENT_NET_PORT=9100

# --- serial ---
RTP_CLIENT_SERIAL_DEVFILE=/dev/ttyUSB0
RTP_CLIENT_SERIAL_BAUDRATE=9600

# --- file (raw device node, e.g. /dev/usb/lp0) ---
RTP_CLIENT_FILE_DEVFILE=/dev/usb/lp0

# --- cups ---
RTP_CLIENT_CUPS_PRINTER_NAME=
