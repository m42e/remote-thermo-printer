# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values.
# The backend reads the RTP_SERVER_* values, the client reads the RTP_CLIENT_*
# values.  Both can live in the same .env file.
# ---------------------------------------------------------------------------

# ===== Backend (server) =====================================================
RTP_SERVER_HOST=0.0.0.0
RTP_SERVER_PORT=8000
# Shared secret. When set, clients and the HTTP API must present this token.
# Leave empty to disable authentication (fine for a trusted LAN).
RTP_SERVER_TOKEN=

# ===== Client (Raspberry Pi) ================================================
# WebSocket URL of the backend. Use wss:// when terminating TLS in front of it.
RTP_CLIENT_SERVER_URL=ws://localhost:8000/ws
RTP_CLIENT_TOKEN=
RTP_CLIENT_PRINTER_ID=pi-printer-1
RTP_CLIENT_PRINTER_NAME=Front desk Epson

# Printer connection: usb | network | serial | file | cups | dummy
RTP_CLIENT_CONNECTION=dummy

# Width of the printer head in dots (80mm -> 576, 58mm -> 384).
# Images and PDF pages wider than this are scaled down to fit.
RTP_CLIENT_PRINTER_WIDTH=576

# Optional python-escpos profile name (enables image centering, etc.)
# RTP_CLIENT_PRINTER_PROFILE=TM-T88III

# --- usb ---
# Find the IDs with `lsusb` (e.g. Epson is 04b8). Hex strings are accepted.
RTP_CLIENT_USB_VENDOR_ID=0x04b8
RTP_CLIENT_USB_PRODUCT_ID=0x0202
# RTP_CLIENT_USB_IN_EP=0x82
# RTP_CLIENT_USB_OUT_EP=0x01

# --- network ---
RTP_CLIENT_NET_HOST=192.168.1.50
RTP_CLIENT_NET_PORT=9100

# --- serial ---
RTP_CLIENT_SERIAL_DEVFILE=/dev/ttyUSB0
RTP_CLIENT_SERIAL_BAUDRATE=9600

# --- file (raw device node, e.g. /dev/usb/lp0) ---
RTP_CLIENT_FILE_DEVFILE=/dev/usb/lp0

# --- cups ---
RTP_CLIENT_CUPS_PRINTER_NAME=
